{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "LinkDeck",
  "description": "__MSG_extensionDescription__",
  "version": "1.1.0",
  "default_locale": "zh_CN",
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "history", "contextMenus", "activeTab", "scripting", "alarms"],
  "host_permissions": ["https://api.github.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "open-tab-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "__MSG_searchTabsCommand__"
    }
  },
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://a.favicon.im;"
  }
}
